# ---- Core app ----
# Port the backend API + (in production) the built UI is served on.
APP_PORT=8080
# Where SQLite DB, per-run logs, and local backup CSVs are stored.
DATA_DIR=./data
# 32-byte hex key used to encrypt Shopify tokens + Google refresh tokens at rest.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Secret used to sign session cookies. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# IANA timezone used for the scheduler (e.g. America/Los_Angeles). Defaults to UTC.
TZ=UTC
# Public base URL of this app (used to build the Google OAuth redirect). For localhost keep as is.
APP_BASE_URL=http://localhost:8080

# ---- Google Drive (optional) ----
# Leave blank to run without Google Drive; backups are still stored locally.
# Create an OAuth 2.0 "Web application" client in Google Cloud Console with the
# Drive API enabled, and add redirect URI: <APP_BASE_URL>/api/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional API key for the Google Picker folder chooser.
GOOGLE_API_KEY=

# ---- Email / SMTP (optional) ----
# Preferred: configure SMTP in the app (Settings → Email). These env vars are a fallback
# used only if nothing is saved in the app. Needed to send user invites and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Coalition Snapback <no-reply@example.com>
